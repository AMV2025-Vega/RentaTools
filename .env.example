# Copie este archivo a ".env" (NO se versiona) y cambie los valores.

# --- PostgreSQL ---
POSTGRES_DB=rentatools
POSTGRES_USER=rentatools
POSTGRES_PASSWORD=cambia-esta-clave

# --- Django ---
# Generar: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
# Lista separada por comas. En AWS agregue la IP elástica o el DNS público de la EC2.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
GUNICORN_WORKERS=3

# --- Integraciones ---
# development: notificaciones por log. production: correo SMTP real.
ENV_TYPE=development
COSTO_SERVICE_URL=http://costo:5000/api/v2/reservas/costo/
COSTO_SERVICE_TIMEOUT=3
